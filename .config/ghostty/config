# Ghostty config — mirrors ~/.config/wezterm/config.lua look & feel
# XDG path: ~/.config/ghostty/config (YADM-tracked via dotfiles repo)
# Targets Ghostty 1.1+ (command_palette / copy_mode / move_tab need 1.1).

# --- Appearance: Tokyo Night, follows system dark/light ---
# WezTerm: appearance.is_dark() ? tokyonight_night : tokyonight_day
theme = "auto"
theme-dark = "tokyonight-night"
theme-light = "tokyonight-day"

# --- Font ---
# WezTerm: JetBrainsMono Nerd Font Mono primary, BlexMono + FiraCode fallbacks
font-family = "JetBrainsMono Nerd Font Mono"
font-family-fallback = "BlexMono Nerd Font Mono, FiraCode Nerd Font Mono"
font-size = 16
# WezTerm harfbuzz_features: calt, liga, ss02, zero
font-feature = "calt=1"
font-feature = "liga=1"
font-feature = "ss02=1"
font-feature = "zero=1"

# --- Window ---
# WezTerm window_padding 0.8cell ≈ 10px at 16pt; Ghostty is pixel-based
window-padding-x = 10
window-padding-y = 10
background-opacity = 0.95
macos-window-blur = 30
# WezTerm INTEGRATED_BUTTONS: traffic lights over content, no titlebar
macos-titlebar-style = "hidden"
macos-native-fullscreen = true
confirm-close-surface = false

# --- Terminal ---
scrollback-limit = 50000
# WezTerm prepends /opt/homebrew/bin to PATH
env = PATH=/opt/homebrew/bin:$PATH

# --- Keybindings (mirror wezterm keybindings.lua) ---
# Palette / selection
keybind = super+shift+p=command_palette
keybind = super+shift+space=quick_select
keybind = super+shift+x=copy_mode

# Tabs: Cmd+Shift+arrows relative, Cmd+1..9 absolute, Cmd+Shift+1..9 move
keybind = super+shift+left=previous_tab
keybind = super+shift+right=next_tab
keybind = super+1=goto_tab(1)
keybind = super+2=goto_tab(2)
keybind = super+3=goto_tab(3)
keybind = super+4=goto_tab(4)
keybind = super+5=goto_tab(5)
keybind = super+6=goto_tab(6)
keybind = super+7=goto_tab(7)
keybind = super+8=goto_tab(8)
keybind = super+9=goto_tab(9)
keybind = super+shift+1=move_tab(1)
keybind = super+shift+2=move_tab(2)
keybind = super+shift+3=move_tab(3)
keybind = super+shift+4=move_tab(4)
keybind = super+shift+5=move_tab(5)
keybind = super+shift+6=move_tab(6)
keybind = super+shift+7=move_tab(7)
keybind = super+shift+8=move_tab(8)
keybind = super+shift+9=move_tab(9)

# Splits: Cmd+Shift+\ horizontal, Cmd+Shift+- vertical (WezTerm parity)
keybind = super+shift+backslash=new_split(right)
keybind = super+shift+minus=new_split(down)
# Pane navigation: Cmd+arrows
keybind = super+left=move_split(left)
keybind = super+down=move_split(down)
keybind = super+up=move_split(up)
keybind = super+right=move_split(right)
# Pane resize: Cmd+Opt+arrows, 5 cells per press
keybind = super+alt+left=resize_split(left,5)
keybind = super+alt+right=resize_split(right,5)
keybind = super+alt+up=resize_split(up,5)
keybind = super+alt+down=resize_split(down,5)
# Pane zoom toggle
keybind = super+z=toggle_split_zoom
# Close pane (WezTerm CloseCurrentPane)
keybind = super+w=close_split

# Word movement: Opt+arrows (emacs-style, matches WezTerm SendString)
keybind = alt+left=send_string:\x1bb
keybind = alt+right=send_string:\x1bf

# Shift+Enter = literal newline (WezTerm SendString \x1b\r)
keybind = shift+enter=send_string:\x1b\r

# Not ported (no Ghostty equivalent):
#   - Ctrl+Tab last-active-tab (no last_tab action)
#   - Cmd+, edit config in emacs (no open-config action)
#   - inactive_pane_hsb dimming (no equivalent)
#   - WebGpu front-end / max_fps (Ghostty renders via Metal natively)
