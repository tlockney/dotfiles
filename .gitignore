# Gitignore settings for ESPHome
# This is an example and may include too much for your use-case.
# You can modify this file to suit your needs.
/.esphome/
/secrets.yaml
.cfg
.cargo/
.ssh/
.rustup/
.npm/
.local/
/src/

**/.claude/settings.local.json

# Materialized per-machine Claude context — only the class alt-files
# (local.md##class.work / .personal, settings.json##class.work / .personal)
# should be tracked; yadm alt materializes the bare files per machine.
.claude/local.md
.claude/settings.json

.config/zsh/local.zsh
.config/raycast-extensions/*/node_modules/
