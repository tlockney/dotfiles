# Ghostty config — mirrors ~/.config/wezterm/config.lua look & feel
# XDG path: ~/.config/ghostty/config.ghostty (YADM-tracked via dotfiles repo)
# Verified against Ghostty 1.3.1 bundled man page (ghostty.5) + shipped themes.

# --- Appearance: Tokyo Night, follows system dark/light ---
# WezTerm: appearance.is_dark() ? tokyonight_night : tokyonight_day
# Syntax is light:name,dark:name; names are case-sensitive.
theme = light:TokyoNight Day,dark:TokyoNight Night

# --- Font ---
# WezTerm: JetBrainsMono Nerd Font Mono primary, BlexMono + FiraCode fallbacks.
# Ghostty has no font-family-fallback key — repeat font-family for fallbacks.
font-family = JetBrainsMono Nerd Font Mono
font-family = BlexMono Nerd Font Mono
font-family = FiraCode Nerd Font Mono
font-size = 16
# WezTerm harfbuzz_features: calt, liga, ss02, zero
font-feature = calt=1
font-feature = liga=1
font-feature = ss02=1
font-feature = zero=1

# --- Window ---
# WezTerm window_padding 0.8cell ≈ 10px at 16pt; Ghostty is pixel-based
window-padding-x = 10
window-padding-y = 10
background-opacity = 0.95
# WezTerm macos_window_background_blur = 30
background-blur = 30
# WezTerm INTEGRATED_BUTTONS: traffic lights over content, no titlebar bg.
# "transparent" keeps the buttons visible; "hidden" removes them entirely.
macos-titlebar-style = transparent
# WezTerm native_macos_fullscreen_mode = true (default in Ghostty)
macos-non-native-fullscreen = false
confirm-close-surface = false

# --- Terminal ---
scrollback-limit = 50000
# WezTerm prepends /opt/homebrew/bin to PATH. Ghostty does NOT expand $VAR in
# env values, and the interactive shell (zsh) fixes PATH on startup anyway,
# so this is intentionally omitted.

# --- Keybindings (mirror wezterm keybindings.lua) ---
# Palette
keybind = super+shift+p=toggle_command_palette

# Tabs: Cmd+Shift+arrows relative, Cmd+1..9 absolute, Ctrl+Tab last-active
keybind = super+shift+left=previous_tab
keybind = super+shift+right=next_tab
keybind = ctrl+tab=last_tab
keybind = super+1=goto_tab:1
keybind = super+2=goto_tab:2
keybind = super+3=goto_tab:3
keybind = super+4=goto_tab:4
keybind = super+5=goto_tab:5
keybind = super+6=goto_tab:6
keybind = super+7=goto_tab:7
keybind = super+8=goto_tab:8
keybind = super+9=goto_tab:9
# WezTerm MoveTab(i-1) is absolute; Ghostty move_tab is RELATIVE offset.
keybind = super+shift+1=move_tab:1
keybind = super+shift+2=move_tab:2
keybind = super+shift+3=move_tab:3
keybind = super+shift+4=move_tab:4
keybind = super+shift+5=move_tab:5
keybind = super+shift+6=move_tab:6
keybind = super+shift+7=move_tab:7
keybind = super+shift+8=move_tab:8
keybind = super+shift+9=move_tab:9

# Splits: Cmd+Shift+\ horizontal, Cmd+Shift+- vertical (WezTerm parity)
keybind = super+shift+backslash=new_split:right
keybind = super+shift+minus=new_split:down
# Pane navigation: Cmd+arrows (Ghostty action is goto_split)
keybind = super+left=goto_split:left
keybind = super+down=goto_split:down
keybind = super+up=goto_split:up
keybind = super+right=goto_split:right
# Pane resize: Cmd+Opt+arrows, 5 cells per press
keybind = super+alt+left=resize_split:left,5
keybind = super+alt+right=resize_split:right,5
keybind = super+alt+up=resize_split:up,5
keybind = super+alt+down=resize_split:down,5
# Pane zoom toggle
keybind = super+z=toggle_split_zoom
# Close surface (WezTerm CloseCurrentPane; Ghostty has no close_split)
keybind = super+w=close_surface
# Edit config (WezTerm Cmd+, opens emacs on config file)
keybind = super+,=open_config

# Word movement: Opt+arrows (emacs-style, matches WezTerm SendString)
keybind = alt+left=text:\x1bb
keybind = alt+right=text:\x1bf

# Shift+Enter = literal newline (WezTerm SendString \x1b\r)
keybind = shift+enter=text:\x1b\r

# Not ported (no Ghostty 1.3.1 equivalent):
#   - Cmd+Shift+Space QuickSelect (no pattern-select action)
#   - Cmd+Shift+X CopyMode (no vi copy mode; search mode is not equivalent)
#   - inactive_pane_hsb dimming (no equivalent)
#   - WebGpu front-end / max_fps (Ghostty renders via Metal natively)
